# DShop Worker 本地开发环境变量示例（对应 apps/api/src/env.ts 的 Env 绑定）
#
# 用法：
#   1. 复制本文件为 .dev.vars：cp apps/api/.dev.vars.example apps/api/.dev.vars
#   2. 把下列占位值替换为本地开发用的随机值（生产禁用这些值）。
#   3. .dev.vars 已被根 .gitignore 忽略（第 17 行），**绝不提交**。
#
# 生产环境不写 .dev.vars，改用 wrangler secret put 注入（见 docs/09-认证权限与部署.md §10）：
#   npx wrangler secret put JWT_SECRET --config apps/api/wrangler.jsonc
#
# ⚠️ 以下全部是**明显的占位符**，不是真实密钥；生产必须重新生成。

# JWT HS256 签名密钥（env.ts: JWT_SECRET）
JWT_SECRET="dev-insecure-secret-change-in-production"

# 服务令牌 pepper：HMAC-SHA256(AGENT_TOKEN_PEPPER, token 明文)（env.ts: AGENT_TOKEN_PEPPER）
AGENT_TOKEN_PEPPER="dev-insecure-pepper-change-in-production"

# 手机号等 PII 的 AES-GCM 加密密钥材料（经 SHA-256 派生 32 字节）（env.ts: PHONE_ENC_KEY）
PHONE_ENC_KEY="dev-insecure-key-change-in-production"

# 手机号等值查询的 HMAC pepper（env.ts: PHONE_HASH_PEPPER）
PHONE_HASH_PEPPER="dev-insecure-pepper-change-in-production"

# 环境标识：development / staging / production（env.ts: ENVIRONMENT）
#
# ⚠️ 本文件只影响本地 `wrangler dev`：`.dev.vars` 会**覆盖** wrangler.jsonc 的 `vars`，
#    且不会被 `wrangler deploy` 上传（线上变量用 `wrangler secret put` 或 wrangler.jsonc 的 `vars`）。
#    顶层 wrangler.jsonc 里写的是 `production`，本地开发靠这一行拉回 `development`
#    —— 这样「环境标志」不再兼职开关调试后门（见下）。
ENVIRONMENT="development"

# 演示固定验证码白名单：逗号分隔手机号，`*` = 全部放行，空 = 全部不放行（env.ts: DEMO_FIXED_SMS_CODE）
#
# 短信通道尚未接入（docs/09 §9.1），命中者验证码固定为 `123456`。
# ⚠️ 线上严禁设为 `*`，否则任意手机号都能用 `123456` 登录并建号（认证绕过）。
DEMO_FIXED_SMS_CODE="*"

# 是否要求 Agent 请求签名（env.ts: AGENT_REQUIRE_SIGNATURE，默认关闭）
AGENT_REQUIRE_SIGNATURE="false"
